<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PyPath>$(ProjectDir)../../pysabberstone-pythonnet/pysabberstone/lib</PyPath>
    <AssemblyVersion>8.0.0.2</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\SabberStoneCore8\SabberStoneCore.csproj" />
  </ItemGroup>

  <Target Name="CopyDLLToPy" AfterTargets="Build" Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PyPath)" />
	</Target>

</Project>